{
  "name": "hirelens-backend",
  "version": "1.0.0",
  "description": "HireLens (Ghost Job Radar) Backend System",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "prisma generate && tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/app.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "keywords": [
    "hirelens",
    "ghost-jobs",
    "brightdata",
    "gemini",
    "express",
    "typescript"
  ],
  "author": "HireLens Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^0.14.0",
    "@prisma/client": "^5.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "bullmq": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "ioredis": "^5.3.2",
    "prisma": "^5.10.0",
    "slugify": "^1.6.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.1",
    "vitest": "^3.0.7"
  }
}
