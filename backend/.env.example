# ==============================================================================
# HireLens Backend Environment Configuration Template (.env.example)
# Copy this file to backend/.env and populate with your credentials.
# ==============================================================================

# Server HTTP Port
PORT=3001

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# PostgreSQL Database Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hirelens?schema=public"

# Redis Cache & BullMQ Queue Connection Parameters
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# Scraper Mode: Set to 'true' for zero-setup demo mode with synthetic datasets, 'false' for live Bright Data CLI mode
USE_SYNTHETIC_SCRAPER=true

# Google Gemini API Key for LLM Job Title Normalization (@google/genai)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# If left empty, system runs deterministic rule-based fallback normalization.
GEMINI_API_KEY=""

# Bright Data API Key for Non-Interactive Scraper Studio CLI Authentication (`bdata scraper heal` & `bdata scraper approve`)
# Required for live CLI execution. Generate and copy your API key from: https://brightdata.com/cp/setting/users
BRIGHTDATA_API_KEY=""

# Bright Data Web Scraper IDE Collector Zone IDs (Live Mode)
GREENHOUSE_COLLECTOR_ID="c_mspqhy3e1diimdgaqe"
LEVER_COLLECTOR_ID="c_msoqfr4nik4o54w99"
LINKEDIN_COLLECTOR_ID="gd_l4dx9j9sscpvs7no2"
INDEED_COLLECTOR_ID="gd_l1viktl72bvl7bjuj0"

# Bright Data Scraping Browser WebSocket & Proxy Zone Credentials (Optional Live Mode)
BRIGHTDATA_BROWSER_WS=""
BRIGHTDATA_ZONE=""
BRIGHTDATA_ZONE_PASSWORD=""
